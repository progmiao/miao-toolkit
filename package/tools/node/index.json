{
  "no": 1,
  "command": "node",
  "name": "node.name",
  "description": "node.description",
  "interactive": true,
  "dependencies": {
    "menus": {
      "install": "node.deps.install",
      "update": "node.deps.update",
      "uninstall": "node.deps.uninstall"
    },
    "packages": [
      {
        "name": "volta",
        "checkCommand": "volta --version",
        "version": "latest",
        "install": {
          "type": "winget",
          "packageId": "Volta.Volta"
        }
      }
    ]
  },
  "actions": [
    {
      "command": "install",
      "name": "node.action.install.name",
      "description": "node.action.install.description",
      "script": "lib/browse-install.ps1",
      "param": { "switch": "Install", "alias": "i" },
      "enabled": true
    },
    {
      "command": "pin",
      "name": "node.action.pin.name",
      "description": "node.action.pin.description",
      "script": "lib/pin-project.ps1",
      "param": { "switch": "Pin", "alias": "p" },
      "enabled": true
    },
    {
      "command": "default",
      "name": "node.action.default.name",
      "description": "node.action.default.description",
      "script": "lib/set-default.ps1",
      "param": { "switch": "Default", "alias": "d" },
      "enabled": true
    },
    {
      "command": "uninstall",
      "name": "node.action.uninstall.name",
      "description": "node.action.uninstall.description",
      "script": "lib/uninstall-node.ps1",
      "param": { "switch": "Uninstall", "alias": "u" },
      "enabled": true
    }
  ]
}
