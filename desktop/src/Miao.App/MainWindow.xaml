<Window x:Class="Miao.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Miao"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#060A12">
  <Grid>
    <wv2:WebView2 x:Name="WebView" />

    <!--
      层 A：WebView 未就绪时的宿主占位。
      视觉与 Vue /boot S0 对齐（同色、同 ASCII logo、同氛围），仅填补空白期；
      不展示进度条/日志，避免切换突兀。
    -->
    <Grid x:Name="HostBootOverlay"
          Background="#060A12"
          Panel.ZIndex="10"
          ClipToBounds="True">
      <!-- 氛围层（近似 boot-atmosphere） -->
      <Grid IsHitTestVisible="False">
        <Ellipse Width="420" Height="420"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="48,48,0,0"
                 Opacity="0.55"
                 RenderTransformOrigin="0.5,0.5">
          <Ellipse.Effect>
            <BlurEffect Radius="48" />
          </Ellipse.Effect>
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#8C5EC9D6" Offset="0" />
              <GradientStop Color="#005EC9D6" Offset="0.68" />
            </RadialGradientBrush>
          </Ellipse.Fill>
          <Ellipse.RenderTransform>
            <TranslateTransform x:Name="OrbA" />
          </Ellipse.RenderTransform>
        </Ellipse>
        <Ellipse Width="380" Height="380"
                 HorizontalAlignment="Right"
                 VerticalAlignment="Bottom"
                 Margin="0,0,24,40"
                 Opacity="0.5"
                 RenderTransformOrigin="0.5,0.5">
          <Ellipse.Effect>
            <BlurEffect Radius="48" />
          </Ellipse.Effect>
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="#737C9CFF" Offset="0" />
              <GradientStop Color="#007C9CFF" Offset="0.68" />
            </RadialGradientBrush>
          </Ellipse.Fill>
          <Ellipse.RenderTransform>
            <TranslateTransform x:Name="OrbB" />
          </Ellipse.RenderTransform>
        </Ellipse>

        <Rectangle Opacity="0.18">
          <Rectangle.Fill>
            <DrawingBrush TileMode="Tile" Viewport="0,0,48,48" ViewportUnits="Absolute">
              <DrawingBrush.Drawing>
                <DrawingGroup>
                  <GeometryDrawing Geometry="M0,0 L48,0">
                    <GeometryDrawing.Pen>
                      <Pen Brush="#335EC9D6" Thickness="1" />
                    </GeometryDrawing.Pen>
                  </GeometryDrawing>
                  <GeometryDrawing Geometry="M0,0 L0,48">
                    <GeometryDrawing.Pen>
                      <Pen Brush="#335EC9D6" Thickness="1" />
                    </GeometryDrawing.Pen>
                  </GeometryDrawing>
                </DrawingGroup>
              </DrawingBrush.Drawing>
            </DrawingBrush>
          </Rectangle.Fill>
          <Rectangle.OpacityMask>
            <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45"
                                 RadiusX="0.55" RadiusY="0.45">
              <GradientStop Color="#FF000000" Offset="0.2" />
              <GradientStop Color="#00000000" Offset="0.9" />
            </RadialGradientBrush>
          </Rectangle.OpacityMask>
        </Rectangle>
      </Grid>

      <!-- 舞台：logo + 下方预留槽（与 Vue boot-body-h 对齐） -->
      <StackPanel VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  MaxWidth="820">
        <TextBlock x:Name="HostBootAscii"
                   xml:space="preserve"
                   FontFamily="Consolas, Cascadia Mono, Courier New"
                   FontSize="24"
                   LineHeight="28"
                   Foreground="#5EC9D6"
                   TextAlignment="Left"
                   HorizontalAlignment="Center"
                   SnapsToDevicePixels="True"
                   TextOptions.TextFormattingMode="Display">
          <TextBlock.Effect>
            <DropShadowEffect Color="#5EC9D6" BlurRadius="22" ShadowDepth="0" Opacity="0.55" />
          </TextBlock.Effect>
          <TextBlock.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                  <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                   From="0.72" To="1"
                                   Duration="0:0:0.9" />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </TextBlock.Triggers>
        </TextBlock>

        <!-- 与 Vue .boot-body-slot 同高：S0 空槽，保证与后续页 logo 锚点一致 -->
        <Border Height="184" Margin="0,9,0,0" Width="480" MaxWidth="480">
          <TextBlock x:Name="HostBootHint"
                     Text=""
                     Visibility="Collapsed"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     TextAlignment="Center"
                     FontSize="13"
                     Foreground="#FB7185"
                     TextWrapping="Wrap"
                     MaxWidth="420" />
        </Border>
      </StackPanel>

      <Grid.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
          <BeginStoryboard>
            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
              <DoubleAnimation Storyboard.TargetName="OrbA"
                               Storyboard.TargetProperty="X"
                               From="0" To="28"
                               Duration="0:0:7" />
              <DoubleAnimation Storyboard.TargetName="OrbA"
                               Storyboard.TargetProperty="Y"
                               From="0" To="-22"
                               Duration="0:0:7" />
              <DoubleAnimation Storyboard.TargetName="OrbB"
                               Storyboard.TargetProperty="X"
                               From="0" To="-24"
                               Duration="0:0:9" />
              <DoubleAnimation Storyboard.TargetName="OrbB"
                               Storyboard.TargetProperty="Y"
                               From="0" To="18"
                               Duration="0:0:9" />
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Grid.Triggers>
    </Grid>
  </Grid>
</Window>
