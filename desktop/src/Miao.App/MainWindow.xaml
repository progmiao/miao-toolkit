<Window x:Class="Miao.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Miao"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1180"
        Height="760"
        MinWidth="900"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#060A12">
  <Grid>
    <!--
      WebView 始终 Visible：导航在遮罩窗之下完成，避免 Hidden→Visible 时 HWND 挂接
      导致主窗闪缩。启动遮罩见 BootSplashWindow（独立 HWND，可盖住 WebView）。
    -->
    <wv2:WebView2 x:Name="WebView"
                  Visibility="Visible"
                  DefaultBackgroundColor="#FF060A12" />
  </Grid>
</Window>
