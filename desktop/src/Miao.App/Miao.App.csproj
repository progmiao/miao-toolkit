<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe：无控制台窗口的桌面应用入口 -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationTitle>Miao</ApplicationTitle>
    <RootNamespace>Miao.App</RootNamespace>
    <AssemblyName>Miao</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Miao.Common\Miao.Common.csproj" />
    <ProjectReference Include="..\Miao.Data\Miao.Data.csproj" />
    <ProjectReference Include="..\Miao.Software\Miao.Software.csproj" />
    <ProjectReference Include="..\Miao.Sites\Miao.Sites.csproj" />
    <ProjectReference Include="..\Miao.Utilities\Miao.Utilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" Condition="Exists('wwwroot')" />
    <Content Include="..\..\seeds\**\*" Link="seeds\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
