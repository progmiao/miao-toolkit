{

  "tools": [

    {

      "id": "cc-connect",

      "sort": 50,

      "nameKey": "ccc.name",

      "descriptionKey": "ccc.description",

      "tags": ["ai", "needs-node"],

      "ui": {

        "mode": "panel",

        "entry": "ccConnect"

      },

      "install": {

        "strategy": "npm",

        "npmPackage": "cc-connect",

        "detect": {

          "command": "cc-connect",

          "commandArgs": "--version"

        },

        "update": {

          "strategy": "npm"

        }

      },

      "actions": [

        {

          "id": "install",

          "handler": "generic.npm-global",

          "nameKey": "ccc.action.install"

        },

        {

          "id": "uninstall",

          "handler": "generic.npm-global-uninstall",

          "nameKey": "ccc.action.uninstall"

        }

      ],

      "group": "dev"

    }

  ]

}

