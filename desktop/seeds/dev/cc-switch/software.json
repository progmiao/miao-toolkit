{

  "tools": [

    {

      "id": "cc-switch",

      "sort": 40,

      "nameKey": "ccs.name",

      "descriptionKey": "ccs.description",

      "tags": ["ai", "needs-node"],

      "ui": {

        "mode": "panel",

        "entry": "ccSwitch"

      },

      "install": {

        "strategy": "custom",

        "githubOwner": "farion1231",

        "githubRepo": "cc-switch",

        "detect": {

          "registryUninstallNames": ["CC Switch", "CC-Switch"]

        },

        "update": {

          "strategy": "github-release"

        }

      },

      "actions": [

        {

          "id": "install",

          "handler": "cc-switch.install",

          "nameKey": "ccs.action.install"

        },

        {

          "id": "uninstall",

          "handler": "generic.uninstall",

          "nameKey": "ccs.action.uninstall"

        }

      ],

      "group": "dev"

    }

  ]

}

